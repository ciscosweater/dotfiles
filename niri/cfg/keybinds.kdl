binds {

    // ────────────── Keybindings ──────────────
    // https://github.com/YaLTeR/niri/wiki/Configuration:-Key-Bindings
    //
    // hotkey-overlay-title="..." é o texto que aparece no overlay de atalhos
    // (Mod+Shift+Esc). Binds sem título não aparecem no overlay, exceto as
    // ações que o niri sempre lista (foco/movimento de coluna, workspaces etc).

    // ─── Ajuda e sessão ───
    Mod+Shift+ESCAPE                    hotkey-overlay-title="Mostrar estes atalhos" { show-hotkey-overlay; }
    CTRL+ALT+Delete                     hotkey-overlay-title="Sair do niri" { quit; }

    // ─── Aplicativos ───
    Mod+Return                          hotkey-overlay-title="Terminal (kitty)" { spawn "kitty"; }
    Mod+B                               hotkey-overlay-title="Navegador (Zen)" { spawn "zen-browser"; }
    Mod+E                               hotkey-overlay-title="Arquivos (Nautilus)" { spawn "nautilus"; }

    // ─── Noctalia ───
    Mod+Space                           hotkey-overlay-title="Abrir launcher" { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+CTRL+Return                     { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+S                               hotkey-overlay-title="Central de controle" { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+Ctrl+S                          hotkey-overlay-title="Configurações" { spawn-sh "noctalia msg settings-toggle"; }
    Mod+Shift+Return                    hotkey-overlay-title="Papel de parede" { spawn-sh "noctalia msg panel-toggle wallpaper"; }
    Mod+ALT+L                           hotkey-overlay-title="Bloquear tela" { spawn-sh "noctalia msg session lock"; }
    Mod+Shift+Q                         hotkey-overlay-title="Menu de sessão" { spawn-sh "noctalia msg panel-toggle session"; }

    // ─── Modos de janela ───
    Mod+T                               hotkey-overlay-title="Flutuar/ancorar janela" { toggle-window-floating; }
    Mod+F                               hotkey-overlay-title="Maximizar coluna" { maximize-column; }
    Mod+Shift+F                         hotkey-overlay-title="Tela cheia" { fullscreen-window; }
    Mod+W                               hotkey-overlay-title="Coluna em abas" { toggle-column-tabbed-display; }
    Mod+M                               hotkey-overlay-title="Maximizar até as bordas" { maximize-window-to-edges; }
    Mod+Shift+V                         hotkey-overlay-title="Foco: flutuante ↔ tiling" { switch-focus-between-floating-and-tiling; }

    // ─── Mídia e brilho (não entram no overlay) ───
    XF86AudioRaiseVolume                allow-when-locked=true { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume                allow-when-locked=true { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute                       allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }
    XF86AudioMicMute                    allow-when-locked=true { spawn-sh "noctalia msg mic-mute"; }
    XF86AudioNext                       allow-when-locked=true { spawn-sh "noctalia msg media next"; }
    XF86AudioPrev                       allow-when-locked=true { spawn-sh "noctalia msg media previous"; }
    XF86AudioPlay                       allow-when-locked=true { spawn-sh "noctalia msg media toggle"; }
    XF86AudioPause                      allow-when-locked=true { spawn-sh "noctalia msg media pause"; }
    XF86MonBrightnessUp                 allow-when-locked=true { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown               allow-when-locked=true { spawn-sh "noctalia msg brightness-down"; }

    // ─── Foco ───
    Mod+Q                               hotkey-overlay-title="Fechar janela" { close-window; }

    Mod+Left                            hotkey-overlay-title="Foco: coluna à esquerda" { focus-column-left; }
    Mod+H                               { focus-column-left; }
    Mod+Right                           hotkey-overlay-title="Foco: coluna à direita" { focus-column-right; }
    Mod+L                               { focus-column-right; }
    Mod+Up                              { focus-window-up; }
    Mod+K                               { focus-window-up; }
    Mod+Down                            { focus-window-down; }
    Mod+J                               { focus-window-down; }

    Mod+Home                            { focus-column-first; }
    Mod+End                             { focus-column-last; }

    Mod+Shift+Left                      { focus-monitor-left; }
    Mod+Shift+Right                     { focus-monitor-right; }
    Mod+Shift+UP                        { focus-monitor-up; }
    Mod+Shift+Down                      { focus-monitor-down; }

    // ─── Movimento ───
    Mod+CTRL+Left                       hotkey-overlay-title="Mover coluna à esquerda" { move-column-left; }
    Mod+CTRL+H                          { move-column-left; }
    Mod+CTRL+Right                      hotkey-overlay-title="Mover coluna à direita" { move-column-right; }
    Mod+CTRL+L                          { move-column-right; }
    Mod+CTRL+UP                         { move-window-up; }
    Mod+CTRL+K                          { move-window-up; }
    Mod+CTRL+Down                       { move-window-down; }
    Mod+CTRL+J                          { move-window-down; }

    Mod+CTRL+Home                       { move-column-to-first; }
    Mod+CTRL+End                        { move-column-to-last; }

    Mod+Shift+CTRL+Left                 { move-column-to-monitor-left; }
    Mod+Shift+CTRL+Right                { move-column-to-monitor-right; }
    Mod+Shift+CTRL+UP                   { move-column-to-monitor-up; }
    Mod+Shift+CTRL+Down                 { move-column-to-monitor-down; }

    Mod+BracketLeft                     hotkey-overlay-title="Consumir/expelir à esquerda" { consume-or-expel-window-left; }
    Mod+BracketRight                    hotkey-overlay-title="Consumir/expelir à direita" { consume-or-expel-window-right; }
    Mod+Comma                           { consume-window-into-column; }
    Mod+Period                          { expel-window-from-column; }

    // ─── Tamanho de coluna/janela ───
    Mod+R                               hotkey-overlay-title="Largura: 1/3, 1/2, 2/3" { switch-preset-column-width; }
    Mod+Shift+R                         { switch-preset-column-width-back; }
    Mod+Ctrl+Shift+R                    { switch-preset-window-height; }
    Mod+Ctrl+R                          { reset-window-height; }
    Mod+CTRL+F                          { expand-column-to-available-width; }
    Mod+C                               { center-column; }
    Mod+CTRL+C                          { center-visible-columns; }
    Mod+Minus                           { set-column-width "-10%"; }
    Mod+Equal                           { set-column-width "+10%"; }
    Mod+Shift+Minus                     { set-window-height "-10%"; }
    Mod+Shift+Equal                     { set-window-height "+10%"; }

    // ─── Scroll: Mod = horizontal (colunas) / Mod+Shift = vertical (workspaces) ───
    Mod+WheelScrollDown                 cooldown-ms=100 hotkey-overlay-title="Coluna à direita" { focus-column-right; }
    Mod+WheelScrollUp                   cooldown-ms=100 hotkey-overlay-title="Coluna à esquerda" { focus-column-left; }
    Mod+Shift+WheelScrollDown           cooldown-ms=100 hotkey-overlay-title="Workspace abaixo" { focus-workspace-down; }
    Mod+Shift+WheelScrollUp             cooldown-ms=100 hotkey-overlay-title="Workspace acima" { focus-workspace-up; }

    // Wheel horizontal (touchpad) também navega colunas
    Mod+WheelScrollRight                { focus-column-right; }
    Mod+WheelScrollLeft                 { focus-column-left; }
    Mod+CTRL+WheelScrollRight           { move-column-right; }
    Mod+CTRL+WheelScrollLeft            { move-column-left; }
    Mod+CTRL+WheelScrollDown            cooldown-ms=150 hotkey-overlay-title="Mover coluna p/ workspace abaixo" { move-column-to-workspace-down; }
    Mod+CTRL+WheelScrollUp              cooldown-ms=150 hotkey-overlay-title="Mover coluna p/ workspace acima" { move-column-to-workspace-up; }
    Mod+CTRL+Shift+WheelScrollDown      { move-column-right; }
    Mod+CTRL+Shift+WheelScrollUp        { move-column-left; }

    Mod+1                               { focus-workspace 1; }
    Mod+2                               { focus-workspace 2; }
    Mod+3                               { focus-workspace 3; }
    Mod+4                               { focus-workspace 4; }
    Mod+5                               { focus-workspace 5; }
    Mod+6                               { focus-workspace 6; }
    Mod+7                               { focus-workspace 7; }
    Mod+8                               { focus-workspace 8; }
    Mod+9                               { focus-workspace 9; }

    Mod+CTRL+1                          { move-column-to-workspace 1; }
    Mod+CTRL+2                          { move-column-to-workspace 2; }
    Mod+CTRL+3                          { move-column-to-workspace 3; }
    Mod+CTRL+4                          { move-column-to-workspace 4; }
    Mod+CTRL+5                          { move-column-to-workspace 5; }
    Mod+CTRL+6                          { move-column-to-workspace 6; }
    Mod+CTRL+7                          { move-column-to-workspace 7; }
    Mod+CTRL+8                          { move-column-to-workspace 8; }
    Mod+CTRL+9                          { move-column-to-workspace 9; }

    Mod+TAB                             { focus-workspace-previous; }

    // ─── Visão geral ───
    Mod+O                               repeat=false hotkey-overlay-title="Visão geral" { toggle-overview; }
    Mod+Shift+P                         hotkey-overlay-title="Desligar telas" { power-off-monitors; } // útil para OLED / privacidade

    // ─── Screenshots ───
    Mod+Shift+S                         hotkey-overlay-title="Screenshot: seleção de área" { screenshot; }
    CTRL+Shift+1                        { screenshot; }
    CTRL+Shift+2                        { screenshot-screen; }
    CTRL+Shift+3                        { screenshot-window; }

    // ─── Escape de emergência ───
    // Use quando um app em fullscreen bloqueia os keybinds: desativa o
    // keyboard shortcuts inhibitor e devolve o controle.
    Mod+ESCAPE                          allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // Please set the text editor of your choice.
    // Mod+Shift+E                               hotkey-overlay-title="Editor de texto (Zed)" { spawn "zed"; }
}
